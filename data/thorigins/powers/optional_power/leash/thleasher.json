{
	"type": "origins:multiple",
	"hidden": true,

	"ticks_20": {
		"type": "origins:action_over_time",
		"interval": 20,
		"entity_action": {
			"type": "origins:revoke_power",
			"power": "*:optional_power/leash/thleasher",
			"source": "thorigins:temp"
		},
		"condition": {
			"type": "origins:passenger",
			"bientity_condition": {
				"type": "origins:actor_condition",
				"condition": {
					"type": "origins:power",
					"power": "*:optional_power/leash/thleash_anchor"
				}
			},
			"compare_to": 0,
			"comparison": "=="
		}
	},

	"tie_to_fence": {
		"type": "origins:action_on_block_use",
		"action_result": "fail",
		"block_condition": {
			"type": "origins:in_tag",
			"tag": "minecraft:fences"
		},
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:passenger_action",
					"bientity_condition": {
						"type": "origins:target_condition",
						"condition": {
							"type": "origins:power",
							"power": "*:optional_power/leash/thleash_anchor"
						}
					},
					"action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:execute_command",
								"command": "/tag @s add temp"
							},
							{
								"type": "origins:change_resource",
								"resource": "*:optional_power/leash/thleash_anchor_tied",
								"change": 1
							}
						]
					}
				},
				{
					"type": "origins:execute_command",
					"command": "/title @s actionbar {\"translate\":\"tied_leash_to_fence\"}"
				},
				{
					"type": "origins:delay",
					"ticks": 1,
					"action": {
						"type": "origins:revoke_power",
						"power": "*:optional_power/leash/thleasher",
						"source": "thorigins:temp"
					}
				}
			]
		},
		"block_action": {
				"type": "origins:and",
				"actions": [
					{
						"type": "origins:execute_command",
						"command": "/summon marker ~ ~-0.5 ~ {Tags:[\"tp_marker\"]}"
					},
					{
						"type": "origins:execute_command",
						"command": "/tag @e[tag=leash_anchor,tag=temp,distance=..1] remove temp"
					},
					{
						"type": "origins:execute_command",
						"command": "/playsound minecraft:entity.leash_knot.place player @a[distance=..16] ~ ~ ~ 1 1.4"
					},
					{
						"type": "origins:delay",
						"ticks": 1,
						"action": {
							"type": "origins:execute_command",
							"command": "/kill @e[type=marker,tag=tp_marker,distance=..1]"
						}
					}
				]
			
		}
	}
}
