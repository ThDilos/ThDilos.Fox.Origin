{
	"type": "origins:multiple",
	"hidden": true,

	"init": {
		"type": "origins:action_on_callback",
		"entity_action_added": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/scoreboard objectives add leashedUUID0 dummy"
				},
				{
					"type": "origins:execute_command",
					"command": "/scoreboard objectives add leashTargetUUID0 dummy"
				},
				{
					"type": "origins:execute_command",
					"command": "/execute store result score @s leashedUUID0 run data get entity @s UUID[0] 1"
				}
			]
		}
	},

	"spam_counter": {
		"type": "origins:resource",
		"min": 0,
		"max": 5,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:change_resource",
					"resource": "*:*_leashed",
					"change": -1
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_spam_counter",
					"change": 0,
					"operation": "set"
				}
			]
		}
	},

	"spammer": {
		"type": "origins:active_self",
		"key": "key.sneak",
		"cooldown": 1,
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_spam_counter",
			"change": 1
		}
	},

	"keep_alive": {
		"type": "origins:resource",
		"start_value": 0,
		"min": 0,
		"max": 5,
		"min_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:play_sound",
					"sound": "minecraft:entity.leash_knot.break",
					"category": "players",
					"pitch": 1.2,
					"volume": 1
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_leashed",
					"change": -1
				}
			]
		}
	},

	"ticks_20": {
		"type": "origins:action_over_time",
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:*_spam_counter",
			"change": 0,
			"operation": "set"
		}
	},

	"leashed": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/advancement grant @s only thorigins:fox_origin/leashed"
				},
				{
					"type": "origins:execute_command",
					"command": "/tag @s add leashed"
				},
				{
					"type": "origins:play_sound",
					"sound": "minecraft:entity.leash_knot.place",
					"category": "players",
					"volume": 1,
					"pitch": 1.2
				}
			]
		},
		"min_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/tag @s remove leashed"
				},
				{
					"type": "origins:play_sound",
					"sound": "minecraft:entity.leash_knot.place",
					"category": "players",
					"volume": 1,
					"pitch": 1
				}
			]
		}
	},

	"leashable": {
		"type": "origins:action_on_being_used",
		"bientity_condition": {
			"type": "origins:or",
			"conditions": [
				{
					"type": "origins:and",
					"conditions": [
						{
							"type": "origins:actor_condition",
							"condition": {
								"type": "origins:equipped_item",
								"equipment_slot": "mainhand",
								"item_condition": {
									"type": "origins:ingredient",
									"ingredient": {
										"item": "minecraft:lead"
									}
								}
							}
						},
						{
							"type": "origins:target_condition",
							"condition": {
								"type": "origins:resource",
								"resource": "*:*_leashed",
								"compare_to": 0,
								"comparison": "=="
							}
						}
					]
				},
				{
					"type": "origins:target_condition",
					"condition": {
						"type": "origins:resource",
						"resource": "*:*_leashed",
						"compare_to": 1,
						"comparison": "=="
					}
				}
			]
		},
		"bientity_action": {
			"type": "origins:if_else",
			"condition": {
				"type": "origins:target_condition",
				"condition": {
					"type": "origins:resource",
					"resource": "*:*_leashed",
					"compare_to": 0,
					"comparison": "=="
				}
			},
			"if_action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:actor_condition",
					"condition": {
						"type": "origins:equipped_item",
						"equipment_slot": "mainhand",
						"item_condition": {
							"type": "origins:ingredient",
							"ingredient": {
								"item": "minecraft:lead"
							}
						}
					}
				},
				"if_action": {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:actor_action",
							"action": {
								"type": "origins:equipped_item_action",
								"equipment_slot": "mainhand",
								"item_action": {
									"type": "origins:consume",
									"amount": 1
								}
							}
						},
						{
							"type": "origins:actor_action",
							"action": {
								"type": "origins:if_else",
								"condition": {
									"type": "origins:power",
									"power": "*:optional_power/leash/thleasher",
									"source": "thorigins:temp",
									"inverted": true
								},
								"if_action": {
									"type": "origins:grant_power",
									"power": "*:optional_power/leash/thleasher",
									"source": "thorigins:temp"
								}
							}
						},
						{
							"type": "origins:target_action",
							"action": {
								"type": "origins:and",
								"actions": [
									{
										"type": "origins:change_resource",
										"resource": "*:*_leashed",
										"change": 1
									},
									{
										"type": "origins:execute_command",
										"command": "/summon armor_stand ~ ~ ~ {Invisible:0b,NoBasePlate:1b,DisabledSlots:4144959,Invulnerable:1b,NoGravity:1b,PersistenceRequired:1b,Silent:1b,Tags:[\"leash_anchor\",\"unbounded\"]}"
									},
									{
										"type": "origins:execute_command",
										"command": "/execute store result score @e[tag=leash_anchor,tag=unbounded,type=armor_stand,limit=1,sort=nearest] leashTargetUUID0 run data get entity @s UUID[0] 1"
									}
								]
							}
						},
						{
							"type": "origins:actor_action",
							"action": {
								"type": "origins:area_of_effect",
								"radius": 10,
								"bientity_condition": {
									"type": "origins:target_condition",
									"condition": {
										"type": "origins:and",
										"conditions": [
											{
												"type": "origins:entity_type",
												"entity_type": "minecraft:armor_stand"
											},
											{
												"type": "origins:command",
												"command": "/execute if entity @s[tag=leash_anchor,tag=unbounded]",
												"compare_to": 0,
												"comparison": ">"
											}
										]
									}
								},
								"bientity_action": {
									"type": "origins:and",
									"actions": [
										{
											"type": "origins:invert",
											"action": {
												"type": "origins:mount"
											}
										},
										{
											"type": "origins:target_action",
											"action": {
												"type": "origins:grant_power",
												"power": "*:optional_power/leash/thleash_anchor",
												"source": "thorigins:temp"
											}
										},
										{
											"type": "origins:if_else",
											"condition": {
												"type": "origins:actor_condition",
												"condition": {
													"type": "origins:sneaking"
												}
											},
											"if_action": {
												"type": "origins:target_action",
												"action": {
													"type": "origins:change_resource",
													"resource": "*:optional_power/leash/thleash_anchor_extended",
													"change": 1
												}
											},
											"else_action": {
												"type": "origins:actor_action",
												"action": {
													"type": "origins:execute_command",
													"command": "/title @s actionbar {\"translate\":\"leash_tip\"}"
												}
											}
										}
									]
								}
							}
						}
					]
				}
			},
			"else_action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:target_condition",
					"condition": {
						"type": "origins:command",
						"command": "/resource get @e[tag=leash_anchor,limit=1,sort=nearest,type=armor_stand] thorigins:optional_power/leash/thleash_anchor_tied",
						"compare_to": 1,
						"comparison": "=="
					}
				},
				"if_action": {
					"type": "origins:if_else",
					"condition": {
						"type": "origins:actor_condition",
						"condition": {
							"type": "origins:sneaking"
						}
					},
					"if_action": {
						"type": "origins:target_action",
						"action": {
							"type": "origins:change_resource",
							"resource": "*:*_leashed",
							"change": -1
						}
					}
				},
				"else_action": {
					"type": "origins:target_action",
					"action": {
						"type": "origins:change_resource",
						"resource": "*:*_leashed",
						"change": -1
					}
				}
			}
		}
	},

	"ticks": {
		"type": "origins:action_over_time",
		"interval": 1,
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:change_resource",
					"resource": "*:*_keep_alive",
					"change": -1
				},
				{
					"type": "origins:execute_command",
					"command": "/tag @s add temp"
				},
				{
					"type": "origins:area_of_effect",
					"radius": 100,
					"shape": "sphere",
					"bientity_condition": {
						"type": "origins:target_condition",
						"condition": {
							"type": "origins:and",
							"conditions": [
								{
									"type": "origins:entity_type",
									"entity_type": "minecraft:armor_stand"
								},
								{
									"type": "origins:command",
									"command": "/execute if score @s leashTargetUUID0 = @e[tag=temp,limit=1,distance=..100] leashedUUID0",
									"compare_to": 0,
									"comparison": ">"
								}
							]
						}
					},
					"bientity_action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:actor_action",
								"action": {
									"type": "origins:change_resource",
									"resource": "*:*_keep_alive",
									"change": 999
								}
							},
							{
								"type": "origins:target_action",
								"action": {
									"type": "origins:if_else",
									"condition": {
										"type": "origins:resource",
										"resource": "*:optional_power/leash/thleash_anchor_tied",
										"compare_to": 1,
										"comparison": "=="
									},
									"if_action": {
										"type": "origins:execute_command",
										"command": "tp @s ^ ^ ^ facing entity @e[tag=temp,limit=1,distance=..100] feet"
									},
									"else_action": {
										"type": "origins:execute_command",
										"command": "tp @s ^ ^ ^ facing entity @e[tag=temp,limit=1,distance=..100] eyes"
									}
								}
							},
							{
								"type": "origins:if_else",
								"condition": {
									"type": "origins:distance",
									"compare_to": 5,
									"comparison": ">="
								},
								"if_action": {
									"type": "origins:invert",
									"action": {
										"type": "origins:add_velocity",
										"z": -0.25
									}
								}
							}
						]
					}
				},
				{
					"type": "origins:execute_command",
					"command": "/tag @s remove temp"
				}
			]
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_leashed",
			"compare_to": 1,
			"comparison": "=="
		}
	}
}
