{
	"type": "origins:multiple",
	"hidden": true,

	"extended": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0
	},

	"_init_": {
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/tag @s remove unbounded"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale delay set pehkui:width 0"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale delay set pehkui:height 0"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale set pehkui:width 0"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale set pehkui:height 0"
				}
			]
		}
	},

	"ticks_2": {
		"type": "origins:action_over_time",
		"interval": 2,
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/tag @s add temp"
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:resource",
						"resource": "*:*_tied",
						"compare_to": 1,
						"comparison": "=="
					},
					"if_action": {
						"type": "origins:if_else",
						"condition": {
							"type": "origins:in_block",
							"block_condition": {
								"type": "origins:block",
								"block": "minecraft:air"
							}
						},
						"if_action": {
							"type": "origins:change_resource",
							"resource": "*:*_exit",
							"change": 1
						}
					},
					"else_action": {
						"type": "origins:if_else",
						"condition": {
							"type": "origins:riding",
							"bientity_condition": {
								"type": "origins:target_condition",
								"condition": {
									"type": "origins:power",
									"power": "*:optional_power/leash/thleasher"
								}
							},
							"inverted": true
						},
						"if_action": {
							"type": "origins:change_resource",
							"resource": "*:*_exit",
							"change": 1
						}
					}
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:resource",
						"resource": "*:*_extended",
						"compare_to": 0,
						"comparison": "=="
					},
					"if_action": {
						"type": "origins:raycast",
						"distance": 10,
						"command_along_ray": "/particle dust 0.33 0.18 0.11 0.4 ~ ~ ~ 0 0 0 0 1",
						"command_step": 0.1,
						"block": false,
						"bientity_condition": {
							"type": "origins:and",
							"conditions": [
								{
									"type": "origins:riding",
									"inverted": true
								},
								{
									"type": "origins:target_condition",
									"condition": {
										"type": "origins:resource",
										"resource": "*:optional_power/leash/thleash_leashed",
										"compare_to": 1,
										"comparison": "=="
									}
								}
							]
						}
					},
					"else_action": {
						"type": "origins:raycast",
						"distance": 100,
						"command_along_ray": "/particle dust 0.33 0.18 0.11 0.4 ~ ~ ~ 0 0 0 0 1",
						"command_step": 0.1,
						"block": false,
						"bientity_condition": {
							"type": "origins:and",
							"conditions": [
								{
									"type": "origins:riding",
									"inverted": true
								},
								{
									"type": "origins:target_condition",
									"condition": {
										"type": "origins:resource",
										"resource": "*:optional_power/leash/thleash_leashed",
										"compare_to": 1,
										"comparison": "=="
									}
								}
							]
						}
					}
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:or",
						"conditions": [
							{
								"type": "origins:and",
								"conditions": [
									{
										"type": "origins:resource",
										"resource": "*:*_extended",
										"compare_to": 0,
										"comparison": "=="
									},
									{
										"type": "origins:command",
										"command": "/execute as @e[tag=leashed,distance=..10] if score @s leashedUUID0 = @e[tag=temp,tag=leash_anchor,limit=1,sort=nearest] leashTargetUUID0",
										"compare_to": 0,
										"comparison": "=="
									}
								]
							},
							{
								"type": "origins:and",
								"conditions": [
									{
										"type": "origins:resource",
										"resource": "*:*_extended",
										"compare_to": 1,
										"comparison": "=="
									},
									{
										"type": "origins:command",
										"command": "/execute as @e[tag=leashed,distance=..100] if score @s leashedUUID0 = @e[tag=temp,tag=leash_anchor,limit=1,sort=nearest] leashTargetUUID0",
										"compare_to": 0,
										"comparison": "=="
									}
								]
							}
						]
					},
					"if_action": {
						"type": "origins:change_resource",
						"resource": "*:*_exit",
						"change": 1
					}
				},
				{
					"type": "origins:execute_command",
					"command": "/tag @s remove temp"
				}
			]
		}
	},

	"invis": {
		"type": "origins:invisibility"
	},

	"tied": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/scale set pehkui:width 0.01 @s"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale set pehkui:height 0.5 @s"
				},
				{
					"type": "origins:dismount"
				},
				{
					"type": "origins:execute_command",
					"command": "/execute at @e[type=marker,tag=tp_marker,limit=1,sort=nearest] run tp @s ~ ~ ~"
				}
			]
		}
	},

	"exit": {
		"type": "origins:resource",
		"min": 0,
		"max": 2,
		"start_value": 0,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/summon item ~ ~ ~ {Item:{id:\"minecraft:lead\",Count:1b}}"
				},
				{
					"type": "origins:execute_command",
					"command": "/kill @s"
				}
			]
		}
	}
}
