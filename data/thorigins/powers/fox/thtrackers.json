{
	"type": "origins:multiple",
	"hidden": true,

	"first_time_chosen": {
		"type": "origins:toggle",
		"active_by_default": false,
		"key": "nuh.uh"
	},

	"fox_avatar_enabled": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0
	},

	"nightvision_fix": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0,
		"min_action": {
			"type": "origins:clear_effect",
			"effect": "minecraft:night_vision"
		}
	},

	"halt_afk_timer": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0
	},

	"destroy_terrain": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 1
	},

	"activate_soundboard": {
		"type": "origins:resource",
		"min": 0,
		"max": 1,
		"start_value": 0
	},

	"unflammability": {
		"type": "origins:cooldown",
		"cooldown": 6000
	},

	"flammability_notification": {
		"type": "origins:resource",
		"start_value": 0,
		"min": 0,
		"max": 1,
		"min_action": {
			"type": "origins:execute_command",
			"command": "/title @s actionbar {\"translate\":\"fluff_damped_good\"}"
		},
		"max_action": {
			"type": "origins:execute_command",
			"command": "/title @s actionbar {\"translate\":\"fluff_fired_oh_no\"}"
		}
	},

	"_init_": {
		"type": "origins:action_on_callback",
		"entity_action_added": {
			"type": "origins:delay",
			"ticks": 1,
			"action": {
				"type": "origins:and",
				"actions": [
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add thorigins.killed.warden minecraft.killed:minecraft.warden"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add thorigins.thunder.struck dummy"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add thorigins.time.in.nether dummy"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add thorigins.time.in.end dummy"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard players add @s thorigins.killed.warden 0"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard players add @s thorigins.thunder.struck 0"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard players add @s thorigins.time.in.nether 0"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard players add @s thorigins.time.in.end 0"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add thorigins.foxie.death deathCount"
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard players add @s thorigins.foxie.death 0"
					},
					{
						"type": "origins:if_else",
						"condition": {
							"type": "origins:origin",
							"layer": "thorigins:foxsize",
							"origin": "origins:empty"
						},
						"if_action": {
							"type": "origins:execute_command",
							"command": "/origin gui @s thorigins:foxsize"
						}
					},
					{
						"type": "origins:if_else",
						"condition": {
							"type": "origins:resource",
							"resource": "*:fox/universal_settings_optional_mute_fallsound",
							"compare_to": 1,
							"comparison": "=="
						},
						"if_action": {
							"type": "origins:grant_power",
							"power": "*:optional_power/thfallsound",
							"source": "thorigins:universal"
						},
						"else_action": {
							"type": "origins:revoke_power",
							"power": "*:optional_power/thfallsound",
							"source": "thorigins:universal"
						}
					},
					{
						"type": "origins:if_else",
						"condition": {
							"type": "origins:resource",
							"resource": "*:fox/universal_settings_optional_leash",
							"compare_to": 1,
							"comparison": "=="
						},
						"if_action": {
							"type": "origins:grant_power",
							"power": "*:optional_power/leash/thleash",
							"source": "thorigins:universal"
						},
						"else_action": {
							"type": "origins:revoke_power",
							"power": "*:optional_power/leash/thleash",
							"source": "thorigins:universal"
						}
					},
					{
						"type": "origins:execute_command",
						"command": "/scoreboard objectives add UUID0 dummy \"UUID0\""
					},
					{
						"type": "origins:execute_command",
						"command": "/execute store result score @s UUID0 run data get entity @s UUID[0]"
					}
				]
			}
		},
		"entity_action_lost": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:revoke_power",
					"power": "*:optional_power/thfallsound",
					"source": "thorigins:universal"
				},
				{
					"type": "origins:revoke_power",
					"power": "*:optional_power/leash/thleash",
					"source": "thorigins:universal"
				}
			]
		}
	},

	"scale_modified": {
		"type": "origins:resource",
		"start_value": 0,
		"min": 0,
		"max": 2,
		"max_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "/scale reset @s"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale persist set true @s"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale multiply pehkui:drops 0.7 @s"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale multiply pehkui:visibility 0.8 @s"
				},
				{
					"type": "origins:execute_command",
					"command": "/scale easing set pehkui:height pehkui:exponential_out @s"
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_scale_modified",
					"change": 1,
					"operation": "set"
				}
			]
		}
	},

	"origin_tracker": {
		"type": "origins:resource",
		"min": 0,
		"max": 5,
		"start_value": 0
	},

	"ticks_20": {
		"type": "origins:action_over_time",
		"interval": 20,
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:all_of",
						"conditions": [
							{
								"type": "origins:command",
								"command": "/origin has @s origins:origin thorigins:element_fox",
								"compare_to": 0,
								"comparison": "=="
							},
							{
								"type": "origins:command",
								"command": "/origin has @s origins:origin thorigins:fox",
								"compare_to": 0,
								"comparison": "=="
							}
						]
					},
					"if_action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:execute_command",
								"command": "/tag @s remove foxie"
							},
							{
								"type": "origins:if_else",
								"condition": {
									"type": "origins:resource",
									"resource": "*:*_scale_modified",
									"compare_to": 1,
									"comparison": "=="
								},
								"if_action": {
									"type": "origins:and",
									"actions": [
										{
											"type": "origins:change_resource",
											"resource": "*:*_scale_modified",
											"change": 0,
											"operation": "set"
										},
										{
											"type": "origins:execute_command",
											"command": "/scale reset @s"
										}
									]
								}
							},
							{
								"type": "origins:execute_command",
								"command": "/origin set @s thorigins:foxsize foxsize:empty"
							},
							{
								"type": "origins:revoke_power",
								"power": "thorigins:fox/universal_settings",
								"source": "thorigins:universal"
							},
							{
								"type": "origins:revoke_power",
								"power": "*:*__init_",
								"source": "thorigins:universal"
							}
						]
					},
					"else_action": {
						"type": "origins:if_else",
						"condition": {
							"type": "origins:nbt",
							"nbt": "{ \"Tags\": [\"foxie\"] }",
							"inverted": true
						},
						"if_action": {
							"type": "origins:execute_command",
							"command": "/tag @s add foxie"
						}
					}
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:and",
						"conditions": [
							{
								"type": "origins:resource",
								"resource": "*:*_flammability_notification",
								"compare_to": 1,
								"comparison": "=="
							},
							{
								"type": "origins:resource",
								"resource": "*:*_unflammability",
								"compare_to": 5980,
								"comparison": ">="
							}
						]
					},
					"if_action": {
						"type": "origins:change_resource",
						"resource": "*:*_flammability_notification",
						"change": -1
					}
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:advancement",
						"advancement": "thorigins:utils/totem_trigger"
					},
					"if_action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:execute_command",
								"command": "/advancement revoke @s only thorigins:utils/totem_trigger"
							},
							{
								"type": "origins:execute_command",
								"command": "/scoreboard players add @s thorigins.foxie.death 1"
							}
						]
					}
				}
			]
		}
	},

	"thunderstruck_tracker": {
		"type": "origins:action_when_damage_taken",
		"damage_condition": {
			"type": "origins:name",
			"name": "lightningBolt"
		},
		"entity_action": {
			"type": "origins:execute_command",
			"command": "/scoreboard players add @s thorigins.thunder.struck 1"
		},
		"cooldown": 0
	}
}
